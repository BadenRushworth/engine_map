<!DOCTYPE html>
<html>
<head>
  <title><%= @target.name.titleize %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%%= csrf_meta_tags %>
  <%%= csp_meta_tag %>
  <%%= yield :head %>

  <%%= engine_stylesheet_link_tags "<%= @target.name %>", :all %>
  <%%= <%= @target.name %>_javascript_importmap_tags %>
</head>
<body>
  <%%= yield %>
</body>
</html>
